PORT=3000
NODE_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flexibook
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flexibook?schema=public"

# Redis
REDIS_HOST=localhost
